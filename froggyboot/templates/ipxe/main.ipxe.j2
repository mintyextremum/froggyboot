#!ipxe
# Generated by froggyboot from /etc/froggyboot/menu.yml - do not edit by hand.
set srv {{ s.server_ip }}
set base http://${srv}
set proto {{ s.proto }}
set q mac=${net0/mac:hexhyp}
{% if host %}
set host {{ host.name }}
{% else %}
set host ${net0/mac:hexhyp}
{% endif %}
{% set open = menu.sections | selectattr("zone", "equalto", "open") | list %}
{% set protected = menu.sections | rejectattr("zone", "equalto", "open") | list %}
{% if assignment %}

:assigned
menu ADMIN ASSIGNMENT for ${host}: {{ assignment.label }}
item --gap -- This PC will be ERASED and reinstalled automatically (disk {{ assignment.disk }}).
item --gap -- Choose Cancel or press Esc to boot the local disk instead.
item --gap --
item start   Start now (automatic in 15 s)
item cancel  Cancel - boot local disk
choose --default start --timeout 15000 ans || goto local
iseq ${ans} start || goto local
set username assign
set password {{ assignment.token }}
set froggy_jump {{ assignment.entry_obj.id }}
chain ${proto}://${username:uristring}:${password:uristring}@${srv}/{{ assignment.section.path }}?${q} || goto denied
goto local
{% endif %}

{% if exam %}
:main
menu EXAM MODE   ${host}   ${net0/ip}   ${platform}
item --key d local  [d] Boot from local disk
item start          {{ exam.entry.title }}  (default in {{ menu.timeout }} s)
choose --default start --timeout {{ menu.timeout * 1000 }} target || goto local
iseq ${target} start || goto local
set froggy_jump {{ exam.entry.id }}
chain ${base}/{{ exam.section.path }}?${q} || goto main
goto main
{% else %}
:main
menu NETBOOT ${srv}   ${host}   ${net0/ip}   ${platform}
item --gap -- Safe
item --key d local  [d] Boot from local disk  (default in {{ menu.timeout }} s)
{% for sec in open %}
item {% if sec.key %}--key {{ sec.key }} {% endif %}{{ sec.id }}  {{ ("[" ~ sec.key ~ "]") if sec.key else "   " }} {{ sec.title }}  >
{% endfor %}
{% if protected %}
item --gap -- Erases disks - password required
{% for sec in protected %}
item {{ sec.id }}  [!] {{ sec.title }}  >
{% endfor %}
{% endif %}
choose --default local --timeout {{ menu.timeout * 1000 }} target || goto local
goto ${target}
{% endif %}

:local
imgfetch -n ev ${base}/api/event/local?${q} && imgfree ev ||
iseq ${platform} efi && exit ||
sanboot --no-describe --drive 0x80 || exit
{% for sec in open %}

:{{ sec.id }}
imgfetch -n ev ${base}/api/event/{{ sec.id }}?${q} && imgfree ev ||
chain ${base}/{{ sec.path }}?${q} || goto main
goto main
{% endfor %}
{% for sec in protected %}

:{{ sec.id }}
menu !!! WARNING - {{ sec.title | upper }} !!!
{% for line in sec.warning %}
item --gap -- {{ line }}
{% endfor %}
item --gap --
item --gap -- Login: your account, "code" + one-time code, or "ask" (any password)
item --gap -- to request approval from the administrator.
item --gap --
item back   << Back to main menu (default)
item agree  I understand the risk, continue
choose --default back --timeout 30000 ans || goto main
iseq ${ans} agree || goto main
login || goto main
{% if sec.confirm %}
echo Type {{ sec.confirm }} in capital letters to confirm, anything else cancels:
read confirm
iseq ${confirm} {{ sec.confirm }} || goto cancelled
clear confirm
{% endif %}
iseq ${username} ask && goto {{ sec.id }}_ask ||
chain ${proto}://${username:uristring}:${password:uristring}@${srv}/{{ sec.path }}?${q} || goto denied
goto main
:{{ sec.id }}_ask
set tries 0
echo Waiting for the administrator to approve this PC (up to 5 minutes)...
:{{ sec.id }}_wait
chain ${proto}://${username:uristring}:${password:uristring}@${srv}/{{ sec.path }}?${q} && goto main ||
inc tries
iseq ${tries} 60 && goto denied ||
sleep 5
goto {{ sec.id }}_wait
{% endfor %}

:cancelled
clear confirm
clear password
echo Cancelled. Nothing was changed.
sleep 3
goto main

:denied
clear password
echo Wrong password, not approved, machine not allowed, or server error.
sleep 5
goto main
