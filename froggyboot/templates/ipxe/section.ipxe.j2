#!ipxe
# Generated by froggyboot from /etc/froggyboot/menu.yml - do not edit by hand.
# Section "{{ sec.id }}", zone {{ sec.zone }}.
{% if sec.zone == "open" %}
{% set P = "${base}" %}
{% else %}
{% set P = "${zp}" %}
set zp ${proto}://${username:uristring}:${password:uristring}@${srv}/{{ sec.dir }}
{% endif %}
isset ${froggy_jump} || goto menu
set j ${froggy_jump}
clear froggy_jump
goto ${j}

:menu
menu {{ sec.title }}{% if sec.zone != "open" %} - password accepted, this still ERASES disks{% endif %}

{% for e in sec.entries %}
item {{ e.id }}  {{ e.title }}
{% endfor %}
item --gap --
item back  << Back
choose {% if sec.zone != "open" %}--default back {% endif %}target || goto back
goto ${target}
{% for e in sec.entries %}

:{{ e.id }}
{% if e.confirm %}
echo Type {{ e.confirm }} to continue, anything else cancels:
read confirm
iseq ${confirm} {{ e.confirm }} || goto menu
clear confirm
{% endif %}
{% if e.kind == "linux" %}
kernel {{ P }}/{{ e.kernel }}?${q}{% for i in e.initrds %} initrd={{ i.name }}{% endfor %}{% if e.args %} {{ e.args }}{% endif %}

{% for i in e.initrds %}
initrd -n {{ i.name }} {{ P }}/{{ i.path }}?${q}
{% endfor %}
{% if sec.zone != "open" %}
clear password
{% endif %}
boot || goto failed
{% elif e.kind == "memtest" %}
iseq ${platform} efi && goto {{ e.id }}_efi ||
kernel {{ P }}/{{ e.bios }}?${q}
boot || goto failed
:{{ e.id }}_efi
chain {{ P }}/{{ e.efi }}?${q} || goto failed
{% elif e.kind == "wimboot" %}
kernel {{ P }}/wimboot?${q}
initrd -n BCD          {{ P }}/BCD?${q}
initrd -n boot.sdi     {{ P }}/boot.sdi?${q}
initrd -n boot.wim     {{ P }}/boot.wim?${q}
initrd -n winpeshl.ini {{ P }}/{{ e.mode }}/winpeshl.ini?${q}
{% if e.mode == "install" %}
initrd -n install.cmd  {{ P }}/install/install.cmd?${q}
initrd -n froggy.txt   {{ P }}/froggy.txt?${q} ||
{% endif %}
clear password
boot || goto failed
{% elif e.kind == "shell" %}
echo Type exit to return to the menu
shell
goto menu
{% elif e.kind == "reboot" %}
reboot
{% elif e.kind == "poweroff" %}
poweroff
{% endif %}
{% endfor %}

:failed
echo Boot failed - file missing or server error.
sleep 5
{% if sec.zone == "open" %}
goto menu
{% else %}
goto back
{% endif %}

:back
clear password
chain ${base}/menu.ipxe?${q}
