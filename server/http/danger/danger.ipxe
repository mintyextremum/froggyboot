#!ipxe
# Served only to whitelisted MACs with the admin password (nginx).
# Every request carries ?mac=..., because nginx checks the whitelist on the
# whole /danger/ folder, not only on this script.

set dz http://${username:uristring}:${password:uristring}@${srv}/danger

:menu
menu DANGER ZONE - no further questions are asked here
item clonezilla  Clonezilla Live - save / restore disk images
item shredos     ShredOS (nwipe) - WIPE DISKS
item --gap --
item back        << Back
choose --default back target || goto back
goto ${target}

:clonezilla
kernel ${dz}/clonezilla/vmlinuz?${q} initrd=initrd.img boot=live union=overlay username=user config components noswap edd=on nomodeset locales=en_US.UTF-8 keyboard-layouts=NONE ocs_live_run=ocs-live-general ocs_live_batch=no net.ifnames=0 fetch=${base}/blobs/clonezilla/filesystem.squashfs
initrd -n initrd.img ${dz}/clonezilla/initrd.img?${q}
clear password
boot || goto back

:shredos
echo Type WIPE to continue, anything else cancels:
read confirm
iseq ${confirm} WIPE || goto menu
clear confirm
kernel ${dz}/shredos/bzImage?${q}
clear password
boot || goto back

:back
clear password
chain ${base}/menu.ipxe?${q}
