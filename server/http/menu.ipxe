#!ipxe
# Main menu. Default after 10 s: boot local disk.
# Everything that erases disks is behind a disclaimer, a password (checked by
# nginx) and typing ERASE.

set srv @SERVER_IP@
set base http://${srv}
set q mac=${net0/mac:hexhyp}

:main
menu NETBOOT ${srv}   this PC: ${net0/ip}  ${net0/mac:hexhyp}  ${platform}
item --gap -- Safe
item --key d local  [d] Boot from local disk  (default in 10 s)
item --key l linux  [l] Linux installers                       >
item --key t tools  [t] Live systems and tools                 >
item --gap -- Erases disks - password required
item windows        [!] Windows install                        >
item danger         [!] Danger zone                            >
choose --default local --timeout 10000 target || goto local
goto ${target}

:local
iseq ${platform} efi && exit ||
sanboot --no-describe --drive 0x80 || exit

:linux
chain ${base}/linux.ipxe?${q} || goto main

:tools
chain ${base}/tools.ipxe?${q} || goto main

:windows
menu !!! WARNING - WINDOWS INSTALL !!!
item --gap -- Installing Windows ERASES the disk of THIS computer.
item --gap -- All files, programs and other systems on it will be lost.
item --gap -- Continue only if you own this PC or have permission.
item --gap -- The authors take no responsibility for lost data.
item --gap -- Your MAC address and the time are logged.
item --gap --
item back   << Back to main menu (default)
item agree  I understand the risk, continue
choose --default back --timeout 30000 ans || goto main
iseq ${ans} agree || goto main
login || goto main
echo Type ERASE in capital letters to confirm, anything else cancels:
read confirm
iseq ${confirm} ERASE || goto cancelled
clear confirm
chain http://${username:uristring}:${password:uristring}@${srv}/secure/windows.ipxe?${q} || goto denied

:danger
menu !!! DANGER ZONE !!!
item --gap -- Tools here clone over or wipe disks without further questions.
item --gap -- Only for the server administrator on allowed machines.
item --gap --
item back   << Back to main menu (default)
item agree  I am the administrator, continue
choose --default back --timeout 30000 ans || goto main
iseq ${ans} agree || goto main
login || goto main
chain http://${username:uristring}:${password:uristring}@${srv}/danger/danger.ipxe?${q} || goto denied

:cancelled
clear confirm
clear password
echo Cancelled. Nothing was changed.
sleep 3
goto main

:denied
clear password
echo Wrong password, machine not allowed, or server error.
sleep 5
goto main
