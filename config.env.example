# Optional: copy to config.env before the first install.sh run.
# Without it, install.sh asks a few questions and writes /etc/froggyboot/config.env.

# IP of this server in the PC network.
SERVER_IP=192.168.1.10

# Network interface facing the PCs (see: ip -br addr).
IFACE=enp1s0

# PC subnet. dnsmasq answers PXE only here, nginx and Samba serve only it.
NET_CIDR=192.168.1.0/24

# Samba user for WinPE: reads images, writes install reports and backups.
# Letters and digits only, at least 8 characters.
SMB_USER=winpe
SMB_PASS=ChangeMe2026

# MACs allowed into the danger zone, space separated (or danger: true in hosts.yml).
DANGER_MACS="00-1a-2b-3c-4d-5e"

# yes: passwords travel over HTTPS (local CA baked into iPXE).
HTTPS=no

# Port of the app behind nginx (localhost only).
APP_PORT=8070

# Optional Telegram notifications and approve/deny buttons.
# Token from @BotFather; chat id of the admin chat or group.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
