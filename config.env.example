# Copy to config.env and edit. install.sh reads it.

# IP of this Debian server in the classroom network.
SERVER_IP=192.168.1.10

# Network interface facing the classroom (see: ip -br addr).
IFACE=enp1s0

# Classroom subnet. dnsmasq answers PXE only here, nginx and Samba serve only it.
NET_CIDR=192.168.1.0/24

# Read-only Samba user for WinPE. The password ends up inside install.cmd,
# which is behind the Windows password; this user can only read images.
# Letters and digits only, at least 8 characters.
SMB_USER=winpe
SMB_PASS=ChangeMe2026

# MACs allowed into the danger zone, space separated (any case, : or -).
DANGER_MACS="00-1a-2b-3c-4d-5e"
